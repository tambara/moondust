{
	"name": "pages",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"deploy": "bun run build && wrangler deploy",
		"preview": "bun run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply pages --local",
		"db:migrate:remote": "wrangler d1 migrations apply pages --remote"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@better-auth/drizzle-adapter": "^1.7.21",
		"@fontsource-variable/geist": "^5.3.0",
		"better-auth": "^1.7.21",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-orm": "^0.45.4",
		"isbot": "^5.2.3",
		"lucide-react": "^1.72.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"shadcn": "^4.23.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.69.0",
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"wrangler": "^4.160.1"
	}
}